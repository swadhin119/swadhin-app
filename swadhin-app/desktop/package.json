{
  "name": "swadhin-desktop",
  "productName": "SWADHIN",
  "version": "1.0.3",
  "description": "SWADHIN desktop app",
  "author": "Swadhin",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.swadhin.desktop",
    "productName": "SWADHIN",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "downloader.cjs",
      "dlutil.cjs",
      "icon.png",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "SWADHIN-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SWADHIN-Portable-${version}.${ext}"
    }
  }
}